# ---------------- Server ----------------
PORT=5000
NODE_ENV=development

# ---------------- Database ----------------
# Local:  mongodb://127.0.0.1:27017/driveease
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/driveease?retryWrites=true&w=majority
MONGODB_URI=

# ---------------- Auth ----------------
# Use a long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------------- CORS ----------------
# Frontend origin(s). Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173

# ---------------- Cloudinary (image uploads) ----------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=driveease

# ---------------- Initial admin (used by `npm run seed:admin`) ----------------
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------- Business timezone ----------------
# Offset from UTC in minutes used to interpret pickup date/time (India = 330).
TZ_OFFSET_MINUTES=330
